# --- Supabase (PostgreSQL) ---
# Dashboard → Project Settings → Database → Connection string → URI
# Usar el pooler "Transaction" (puerto 6543) para PHP/Python en Hostinger.
# NUNCA subir .env a git. NUNCA poner SERVICE_ROLE en el frontend.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # solo servidor (opcional si usáis solo DATABASE_URL)

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hola@burguardreams.com
SMTP_PASSWORD=
SMTP_FROM=hola@burguardreams.com
SMTP_FROM_NAME=Burguar Dreams
TENANT_DEFAULT_PASSWORD=1234

# URL pública del login (correos de bienvenida). En local: http://127.0.0.1:8010/intranet/login
INTRANET_LOGIN_URL=https://burguardreams.com/intranet/login

# Webhook Apps Script (scripts/google-sheets-utilities.gs) para Subir en Suministros
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# OAuth «Iniciar sesión con Google» (Hostinger: solo hace falta el Client ID, no el secret)
# 1) console.cloud.google.com → proyecto → OAuth consent screen (External) → guardar
# 2) Credentials → Create → OAuth client ID → Web application
# 3) Authorized JavaScript origins (sin barra final):
#    https://burguardreams.com
#    https://www.burguardreams.com   ← si el sitio redirige a www, incluir ambos
#    http://localhost:5173           ← solo desarrollo
# 4) Pegar aquí el Client ID (*.apps.googleusercontent.com)
# 5) Comprobar: https://burguardreams.com/api/auth/google-config.php → enabled:true
# El email de la cuenta Google debe coincidir con users.email en burguar.db
GOOGLE_OAUTH_CLIENT_ID=

# Copilot Burguar — IA gratuita (Google AI Studio → Create API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Alternativa: GROQ_API_KEY=  o  OPENAI_API_KEY=
